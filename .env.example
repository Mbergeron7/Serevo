# ============================================================
# Serevo — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or service_account.json.
# ============================================================

# --- Data source ---
# "generic" = reads from Google Sheets (default, safe for demos)
# "peopleware" = reads from PeopleWare API (client deployments only)
DATA_SOURCE=generic

# --- Google Sheets (required when DATA_SOURCE=generic) ---
SHEET_KEY=                       # Main sheet (tickets, LOA, accommodations)
CAPACITY_SHEET_KEY=              # Capacity sheet (employees, requirements, forecast)
ROSTER_SHEET_ID=                 # Roster sheet (schedules) — falls back to SHEET_KEY
SERVICE_ACCOUNT_FILE=service_account.json

# --- PeopleWare (only when DATA_SOURCE=peopleware) ---
# PW_API_TOKEN=
# PW_API_BASE=
# PW_UTC_OFFSET=-4

# --- App settings ---
WFM_SECRET_KEY=change-me-to-a-long-random-string
PORT=5000

# --- Demo mode ---
# When "true": disables mailbox poller, uses demo login accounts,
# prevents any write-back to live systems.
DEMO_MODE=true

# --- Branding ---
BRAND_NAME=Serevo
BRAND_TAGLINE=Workforce Management Platform
BRAND_SUPPORT_EMAIL=support@bergeronwfm.com
BRAND_ACCENT_COLOR=#0f766e

# --- Email (disabled in demo mode) ---
# SENDGRID_API_KEY=
# SENDGRID_SENDER=
# WFM_MAILBOX=
